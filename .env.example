# Copy to .env.local. Everything is optional for local development:
# without keys, Aivy runs in heuristic + simulated-payment mode.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (either provider) ---------------------------------------------
OPENAI_API_KEY=
# AIVY_OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# AIVY_AI_PROVIDER=anthropic          # prefer Anthropic when both keys are set
# AIVY_ANTHROPIC_MODEL=claude-sonnet-5-5
# AIVY_PRICE_IN_PER_M=0.4             # USD per 1M tokens, for cost tracking
# AIVY_PRICE_OUT_PER_M=1.6
AIVY_DAILY_AI_BUDGET_USD=20           # hard stop for all AI calls per day
AIVY_ASSISTANT_MESSAGE_LIMIT=150      # Ask Aivy messages included per purchase
AIVY_ANALYSES_PER_HOUR=8              # per IP

# --- Website extraction (optional; direct fetch is used otherwise) ----
FIRECRAWL_API_KEY=

# --- Payments ----------------------------------------------------------
# Leave empty to use the simulated test checkout (dev only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# AIVY_ALLOW_SIMULATED_PAYMENTS=false

# --- Email -------------------------------------------------------------
RESEND_API_KEY=
AIVY_EMAIL_FROM="Aivy <hello@yourdomain.com>"
AIVY_SUPPORT_EMAIL=support@yourdomain.com

# --- Operations --------------------------------------------------------
ADMIN_TOKEN=                          # /admin?token=... (required in production)
SENTRY_DSN=
# AIVY_DATA_DIR=.data                 # prototype JSON store location
